# Copy to .env and fill in real values. NEVER commit .env.
# Production values come from the hosting provider (Render / Docker),
# not from this file — this file only documents the variable names.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string.
# Local:   postgres://postgres:<your-postgres-password>@localhost:5432/exam_management
#          (the password you set for the "postgres" user when you installed
#          PostgreSQL — do NOT use "postgres" unless that really is your password)
# Render:  paste the "External Database URL" from the Render database page
#          and append ?sslmode=require  (the backend enables SSL for it).
# Docker:  postgres://postgres:postgres@db:5432/exam_management
DATABASE_URL=postgres://postgres:<your-postgres-password>@localhost:5432/exam_management

# JWT signing secret — MUST be a long random string in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Render this is generated for you (see render.yaml).
JWT_SECRET=change-me-to-a-long-random-secret-before-use
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend origins allowed to call the API.
# Local:   http://localhost:5173  (Vite dev) or http://localhost:8080 (Docker)
# Render:  https://exam-frontend.onrender.com  (your real frontend URL)
CORS_ORIGIN=http://localhost:5173

# Set to 1 to log every SQL query (development debugging only).
LOG_QUERIES=0
