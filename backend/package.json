{
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "exceljs": "^4.4.0",
        "express": "^4.21.2",
        "express-validator": "^7.2.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "pdfkit": "^0.16.0",
        "pg": "^8.13.1"
    },
    "description": "University Examination Department Management System \u2014 backend API (Express + PostgreSQL)",
    "devDependencies": {
        "dotenv": "^16.4.5"
    },
    "engines": {
        "node": ">=18"
    },
    "main": "src/server.js",
    "name": "exam-management-system-backend",
    "scripts": {
        "dev": "node --watch src/server.js",
        "migrate": "psql \"$DATABASE_URL\" -f ../database/migrations/001_init.sql && psql \"$DATABASE_URL\" -f ../database/migrations/002_seed.sql",
        "migrate:schema": "psql \"$DATABASE_URL\" -f ../database/migrations/001_init.sql",
        "seed": "psql \"$DATABASE_URL\" -f ../database/migrations/002_seed.sql",
        "start": "node src/server.js"
    },
    "version": "1.0.0"
}
